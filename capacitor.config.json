{
  "appId": "dk.eatsafe.app",
  "appName": "EatSafe",
  "webDir": "dist",
  "server": {
    "url": "https://www.eatsafe.dk/?src=store",
    "allowNavigation": [
      "www.eatsafe.dk"
    ],
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FBFAF7",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
